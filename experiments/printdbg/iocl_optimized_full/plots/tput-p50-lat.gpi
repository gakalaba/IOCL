set datafile separator ','
set key top left
set xlabel 'Throughput (ops/sec)'
set ylabel 'Latency (ms)'
set terminal pngcairo size 800,600 enhanced dashed font 'DejaVu Sans,12'
set output '/users/akalaba/IOCL/experiments/printdbg/iocl_optimized_full/plots/tput-p50-lat.png'
set style line 1 linetype 1 linewidth 2
set style line 2 linetype 1 linecolor "green" linewidth 2
set style line 3 linetype 1 linecolor "blue" linewidth 2
set style line 4 linetype 4 linewidth 2
set style line 5 linetype 5 linewidth 2
set style line 6 linetype 8 linewidth 2

plot '/users/akalaba/IOCL/experiments/printdbg/iocl_optimized_full/2026-03-28-09-23-43/plots/tput-p50-lat.csv' title 'Full IOCL + Replication' ls 1 with linespoint, \
'/users/akalaba/IOCL/experiments/printdbg/iocl_vr_spanner_final_dummy/2026-03-23-21-43-47/plots/tput-p50-lat.csv' title 'Dummy IOCL' ls 2 with linespoint, \
'/users/akalaba/IOCL/experiments/printdbg/vr_iocl_dummy__bench_client/2026-03-24-10-40-35/plots/tput-p50-lat.csv' title 'Dummy IOCL + bench\_client' ls 3 with linespoint, \
