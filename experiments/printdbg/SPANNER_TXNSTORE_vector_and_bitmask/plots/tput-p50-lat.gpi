set datafile separator ','
set key top left
set xlabel 'Throughput (ops/sec)'
set ylabel 'Latency (ms)'
set terminal pngcairo size 800,600 enhanced dashed font 'DejaVu Sans,12'
set output '/users/akalaba/IOCL/experiments/printdbg/2026-04-07-17-38-18/plots/tput-p50-lat.png'
set style line 1 linetype 1 linewidth 2
set style line 2 linetype 1 linecolor "green" linewidth 2
set style line 3 linetype 1 linecolor "blue" linewidth 2
set style line 4 linetype 4 linewidth 2
set style line 5 linetype 5 linewidth 2
set style line 6 linetype 8 linewidth 2

plot '/users/akalaba/IOCL/experiments/printdbg/spanner_full_w_remaining_fixes/2026-04-07-08-52-11/plots/tput-p50-lat.csv' title 'Spanner full' ls 1 with linespoint, \
'/users/akalaba/IOCL/experiments/printdbg/SPANNER_TXNSTORE_no_RO/2026-04-07-17-18-52/plots/tput-p50-lat.csv' title 'Spanner - no RO in transaction_store' ls 2 with linespoint, \
