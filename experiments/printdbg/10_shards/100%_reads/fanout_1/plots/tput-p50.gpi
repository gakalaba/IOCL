set datafile separator ','
set title "10 shards, fanout=1, 100% reads"
set key top left
set xlabel 'Throughput (txn/s)'
set ylabel 'p50 Latency'
set terminal pngcairo size 800,600 enhanced dashed font 'DejaVu Sans,12'
set output '/users/akalaba/IOCL/experiments/printdbg/10_shards/100%_reads/2026-04-13-15-06-20/plots/tput-p50.png'
set style line 1 linetype 1 linewidth 2
set style line 2 linetype 1 linecolor "green" linewidth 2
set style line 3 linetype 1 linecolor "blue" linewidth 2
set style line 4 linetype 4 linewidth 2
set style line 5 linetype 5 linewidth 2
set style line 6 linetype 8 linewidth 2
plot '/users/akalaba/IOCL/experiments/printdbg/10_shards/100%_reads/2026-04-13-15-06-20/2026-04-13-15-06-20/plots/tput-p50.csv' title 'iocl\_craq' ls 1 with linespoint, \
'/users/akalaba/IOCL/experiments/printdbg/10_shards/100%_reads/2026-04-13-15-06-20/2026-04-13-15-08-14/plots/tput-p50.csv' title 'craq' ls 2 with linespoint, \
'/users/akalaba/IOCL/experiments/printdbg/10_shards/100%_reads/2026-04-13-15-06-20/2026-04-13-15-09-53/plots/tput-p50.csv' title 'vr' ls 3 with linespoint