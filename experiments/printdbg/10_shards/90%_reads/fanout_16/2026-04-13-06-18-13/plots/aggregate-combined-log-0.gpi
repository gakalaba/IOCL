set datafile separator ','
set title "consistency=lin\n10 shards, fanout=16, 90% reads"
set key bottom right
set ytics (0,0.9,0.99,0.999,0.9999,1.0)
set xlabel 'Latency (ms)'
set ylabel 'Cumulative ratio of operations'
set terminal pngcairo size 800,600 enhanced dashed font 'DejaVu Sans,12'
set output '/users/akalaba/IOCL/experiments/printdbg/10_shards/90%_reads/2026-04-13-06-16-31/2026-04-13-06-18-13/plots/aggregate-combined-log-0.png'
set style line 1 linetype 1 linewidth 2
set style line 2 linetype 1 linecolor "green" linewidth 2
set style line 3 linetype 1 linecolor "blue" linewidth 2
set style line 4 linetype 4 linewidth 2
set style line 5 linetype 5 linewidth 2
set style line 6 linetype 8 linewidth 2
plot '/users/akalaba/IOCL/experiments/printdbg/10_shards/90%_reads/2026-04-13-06-16-31/2026-04-13-06-18-13/2026-04-13-06-18-31/out/plots/aggregate-combined-log.csv' using 1:(-log10(1-$2)):yticlabels(3) title "8" ls 1 with lines