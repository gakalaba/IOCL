plot '/users/akalaba/IOCL/experiments/printdbg/10_shards/90%_reads/2026-04-13-15-01-02/2026-04-13-15-02-46/2026-04-13-15-03-04/out/plots/lot-run-0-rw.csv' title "8" ls 1 with lines