set style line 5 linetype 5 linewidth 2
set style line 6 linetype 8 linewidth 2
plot '/users/akalaba/IOCL/experiments/printdbg/10_shards/90%_reads/2026-04-13-14-50-48/2026-04-13-14-52-31/2026-04-13-14-52-48/out/plots/aggregate-region-0-basic-appreq.csv' title "8" ls 1 with lines