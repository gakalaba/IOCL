set datafile separator ','
set terminal pngcairo size 1800,700 enhanced dashed font 'DejaVu Sans,14'
set output 'printdbg/10_shards/combined_plots/fanout1_combined_cdf.png'

set multiplot layout 1,3 title "10 shards, fanout=1 - CDF by read percentage" font "DejaVu Sans Bold,18"

set xrange [195:409]
set yrange [0:1]
set grid xtics ytics lc rgb '#d9d9d9' lw 1
set border lw 1.5
set tics font 'DejaVu Sans,12'
set xtics nomirror
set ytics nomirror
set xlabel 'Latency (ms)' font 'DejaVu Sans,14'
set ylabel 'Cumulative fraction of operations' font 'DejaVu Sans,14'
set style line 1 linecolor rgb '#ff8c00' dt solid linewidth 3.0
set style line 2 linecolor rgb '#1f4e8c' dt solid linewidth 3.0
set style line 3 linecolor rgb '#b23a48' dt solid linewidth 3.0
set style line 4 linecolor rgb '#00d81a' dt solid linewidth 3.0

dx0   = -2.40
dx50  = -0.80
dx90  =  0.80
dx100 =  2.40

set title "IOCL" font "DejaVu Sans Bold,15"
set key outside bottom center horizontal font 'DejaVu Sans,11' spacing 1.0 samplen 3
plot 'printdbg/10_shards/50%_reads/fanout_1/2026-04-13-14-35-12/2026-04-13-14-35-32/out/plots/aggregate-combined.csv' using ($1+dx50):2 title "50%" ls 2 with lines, \
     'printdbg/10_shards/90%_reads/fanout_1/2026-04-13-14-50-48/2026-04-13-14-51-08/out/plots/aggregate-combined.csv' using ($1+dx90):2 title "90%" ls 3 with lines, \
     'printdbg/10_shards/0%_reads/fanout_1/2026-04-13-14-19-24/2026-04-13-14-19-58/out/plots/aggregate-combined.csv' using ($1+dx0):2 title "0%" ls 1 with lines, \
     'printdbg/10_shards/100%_reads/fanout_1/2026-04-13-15-06-20/2026-04-13-15-06-50/out/plots/aggregate-combined.csv' using ($1+dx100):2 title "100%" ls 4 with lines

set title "CRAQ" font "DejaVu Sans Bold,15"
unset ylabel
unset key
plot 'printdbg/10_shards/50%_reads/fanout_1/2026-04-13-14-36-55/2026-04-13-14-37-14/out/plots/aggregate-combined.csv' using ($1+dx50):2 title "50%" ls 2 with lines, \
     'printdbg/10_shards/90%_reads/fanout_1/2026-04-13-14-52-31/2026-04-13-14-52-48/out/plots/aggregate-combined.csv' using ($1+dx90):2 title "90%" ls 3 with lines, \
     'printdbg/10_shards/0%_reads/fanout_1/2026-04-13-14-21-20/2026-04-13-14-21-39/out/plots/aggregate-combined.csv' using ($1+dx0):2 title "0%" ls 1 with lines, \
     'printdbg/10_shards/100%_reads/fanout_1/2026-04-13-15-08-14/2026-04-13-15-08-32/out/plots/aggregate-combined.csv' using ($1+dx100):2 title "100%" ls 4 with lines

set title "VR" font "DejaVu Sans Bold,15"
plot 'printdbg/10_shards/0%_reads/fanout_1/2026-04-13-14-23-00/2026-04-13-14-23-18/out/plots/aggregate-combined.csv' title "0%" ls 1 with lines

unset multiplot
