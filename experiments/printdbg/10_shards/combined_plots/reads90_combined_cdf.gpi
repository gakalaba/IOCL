set datafile separator ','
set title "10 shards, 90% reads - CDF by fanout\n(color=protocol, line style=fanout)" font "DejaVu Sans Bold,16"
set key outside bottom center horizontal font 'DejaVu Sans,13' spacing 1.1 samplen 3 maxrows 3
set xlabel 'Latency (ms)' font 'DejaVu Sans,15'
set ylabel 'Cumulative fraction of operations' font 'DejaVu Sans,15'
set tics font 'DejaVu Sans,13'
set terminal pngcairo size 1700,900 enhanced dashed font 'DejaVu Sans,15'
set output 'printdbg/10_shards/combined_plots/reads90_combined_cdf.png'
set yrange [0:1]
set grid xtics ytics lc rgb '#d9d9d9' lw 1
set border lw 1.5
set logscale x
set format x '%g'
set xtics ("200" 200, "400" 400, "600" 600, "800" 800, "1000" 1000, "1500" 1500, "2000" 2000, "3000" 3000, "5000" 5000, "7000" 7000)
dx = 0.9
set style line 1 linecolor rgb '#b266ff' dt solid linewidth 2.4 pointtype 7 pointsize 1.0
set style line 2 linecolor rgb '#7a00cc' dt (10,5) linewidth 2.4 pointtype 5 pointsize 0.95
set style line 3 linecolor rgb '#4b0082' dt (3,5) linewidth 2.4 pointtype 9 pointsize 0.9
set style line 4 linecolor rgb '#ef9a9a' dt solid linewidth 2.4 pointtype 7 pointsize 1.0
set style line 5 linecolor rgb '#d95f5f' dt (10,5) linewidth 2.4 pointtype 5 pointsize 0.95
set style line 6 linecolor rgb '#b23a48' dt (3,5) linewidth 2.4 pointtype 9 pointsize 0.9
set style line 7 linecolor rgb '#2ca02c' dt solid linewidth 2.4 pointtype 11 pointsize 0.95
plot 'printdbg/10_shards/90%_reads/fanout_1/2026-04-13-14-50-48/2026-04-13-14-51-08/out/plots/aggregate-combined.csv' using ($1-3*dx):2 title "IOCL f=1" ls 1 with lines, \
'printdbg/10_shards/90%_reads/fanout_4/2026-04-13-14-55-54/2026-04-13-14-56-14/out/plots/aggregate-combined.csv' using ($1-2*dx):2 title "IOCL f=4" ls 2 with lines, \
'printdbg/10_shards/90%_reads/fanout_16/2026-04-13-15-01-02/2026-04-13-15-01-22/out/plots/aggregate-combined.csv' using ($1-1*dx):2 title "IOCL f=16" ls 3 with lines, \
'printdbg/10_shards/90%_reads/fanout_1/2026-04-13-14-52-31/2026-04-13-14-52-48/out/plots/aggregate-combined.csv' using ($1+1*dx):2 title "CRAQ f=1" ls 4 with lines, \
'printdbg/10_shards/90%_reads/fanout_4/2026-04-13-14-57-38/2026-04-13-14-57-55/out/plots/aggregate-combined.csv' using ($1+2*dx):2 title "CRAQ f=4" ls 5 with lines, \
'printdbg/10_shards/90%_reads/fanout_16/2026-04-13-15-02-46/2026-04-13-15-03-04/out/plots/aggregate-combined.csv' using ($1+3*dx):2 title "CRAQ f=16" ls 6 with lines, \
'printdbg/10_shards/90%_reads/fanout_1/2026-04-13-14-54-10/2026-04-13-14-54-27/out/plots/aggregate-combined.csv' using ($1+4*dx):2 title "VR f=1" ls 7 with lines
