set datafile separator ','
set title "10 shards, 90% reads — CDF by fanout\n(solid=iocl\\_craq, dotted=craq, grey dash-dot=vr)" font "DejaVu Sans Bold,16"
set key outside right center font 'DejaVu Sans,14' spacing 1.5 samplen 4
set xlabel 'Latency (ms)' font 'DejaVu Sans,15'
set ylabel 'Cumulative fraction of operations' font 'DejaVu Sans,15'
set tics font 'DejaVu Sans,13'
set terminal pngcairo size 1500,800 enhanced dashed font 'DejaVu Sans,15'
set output 'printdbg/10_shards/combined_plots/reads90_combined_cdf.png'
set yrange [0:1]
set grid lc rgb '#cccccc' lw 1
set border lw 1.5
set logscale x
set format x '%g'
set xtics ("200" 200, "400" 400, "600" 600, "800" 800, "1000" 1000, "1500" 1500, "2000" 2000, "3000" 3000, "5000" 5000, "7000" 7000)
set style line 1 linecolor rgb '#1a5276' dt (1,0) linewidth 8
set style line 2 linecolor rgb '#784212' dt (1,0) linewidth 8
set style line 3 linecolor rgb '#145a32' dt (1,0) linewidth 8
set style line 4 linecolor rgb '#5dade2' dt (12,6) linewidth 6
set style line 5 linecolor rgb '#f0b27a' dt (12,6) linewidth 6
set style line 6 linecolor rgb '#58d68d' dt (12,6) linewidth 6
set style line 7 linecolor rgb '#444444' dt (12,5,3,5) linewidth 6
plot 'printdbg/10_shards/90%_reads/fanout_1/2026-04-13-14-50-48/2026-04-13-14-51-08/out/plots/aggregate-combined.csv' title "iocl\\_craq fanout=1" ls 1 with lines, \
'printdbg/10_shards/90%_reads/fanout_4/2026-04-13-14-55-54/2026-04-13-14-56-14/out/plots/aggregate-combined.csv' title "iocl\\_craq fanout=4" ls 2 with lines, \
'printdbg/10_shards/90%_reads/fanout_16/2026-04-13-15-01-02/2026-04-13-15-01-22/out/plots/aggregate-combined.csv' title "iocl\\_craq fanout=16" ls 3 with lines, \
'printdbg/10_shards/90%_reads/fanout_1/2026-04-13-14-52-31/2026-04-13-14-52-48/out/plots/aggregate-combined.csv' title "craq fanout=1" ls 4 with lines, \
'printdbg/10_shards/90%_reads/fanout_4/2026-04-13-14-57-38/2026-04-13-14-57-55/out/plots/aggregate-combined.csv' title "craq fanout=4" ls 5 with lines, \
'printdbg/10_shards/90%_reads/fanout_16/2026-04-13-15-02-46/2026-04-13-15-03-04/out/plots/aggregate-combined.csv' title "craq fanout=16" ls 6 with lines, \
'printdbg/10_shards/90%_reads/fanout_1/2026-04-13-14-54-10/2026-04-13-14-54-27/out/plots/aggregate-combined.csv' title "vr fanout=1" ls 7 with lines
