set datafile separator ','
set title "10 shards, fanout=16 — CDF by read percentage\n(solid=iocl\\_craq, dotted=craq, grey dash-dot=vr)" font "DejaVu Sans Bold,16"
set key outside right center font 'DejaVu Sans,14' spacing 1.5 samplen 4
set xlabel 'Latency (ms)' font 'DejaVu Sans,15'
set ylabel 'Cumulative fraction of operations' font 'DejaVu Sans,15'
set tics font 'DejaVu Sans,13'
set terminal pngcairo size 1600,800 enhanced dashed font 'DejaVu Sans,15'
set output 'printdbg/10_shards/combined_plots/fanout16_combined_cdf.png'
set yrange [0:1]
set grid lc rgb '#cccccc' lw 1
set border lw 1.5
set logscale x
set format x '%g'
set xtics ("200" 200, "400" 400, "600" 600, "800" 800, "1000" 1000, "1500" 1500, "2000" 2000, "3000" 3000, "5000" 5000, "7000" 7000)
set style line 1 linecolor rgb '#1a5276' dt (1,0) linewidth 8
set style line 2 linecolor rgb '#784212' dt (1,0) linewidth 8
set style line 3 linecolor rgb '#145a32' dt (1,0) linewidth 8
set style line 4 linecolor rgb '#4a235a' dt (1,0) linewidth 8
set style line 5 linecolor rgb '#5dade2' dt (12,6) linewidth 6
set style line 6 linecolor rgb '#f0b27a' dt (12,6) linewidth 6
set style line 7 linecolor rgb '#58d68d' dt (12,6) linewidth 6
set style line 8 linecolor rgb '#c39bd3' dt (12,6) linewidth 6
set style line 9 linecolor rgb '#444444' dt (12,5,3,5) linewidth 6
plot 'printdbg/10_shards/0%_reads/fanout_16/2026-04-13-14-29-50/2026-04-13-14-30-10/out/plots/aggregate-combined.csv' title "iocl\\_craq 0%" ls 1 with lines, \
'printdbg/10_shards/50%_reads/fanout_16/2026-04-13-14-45-26/2026-04-13-14-45-47/out/plots/aggregate-combined.csv' title "iocl\\_craq 50%" ls 2 with lines, \
'printdbg/10_shards/90%_reads/fanout_16/2026-04-13-15-01-02/2026-04-13-15-01-22/out/plots/aggregate-combined.csv' title "iocl\\_craq 90%" ls 3 with lines, \
'printdbg/10_shards/100%_reads/fanout_16/2026-04-13-15-16-42/2026-04-13-15-18-27/out/plots/aggregate-combined.csv' title "iocl\\_craq 100%" ls 4 with lines, \
'printdbg/10_shards/0%_reads/fanout_16/2026-04-13-14-31-34/2026-04-13-14-31-52/out/plots/aggregate-combined.csv' title "craq 0%" ls 5 with lines, \
'printdbg/10_shards/50%_reads/fanout_16/2026-04-13-14-47-11/2026-04-13-14-47-28/out/plots/aggregate-combined.csv' title "craq 50%" ls 6 with lines, \
'printdbg/10_shards/90%_reads/fanout_16/2026-04-13-15-02-46/2026-04-13-15-03-04/out/plots/aggregate-combined.csv' title "craq 90%" ls 7 with lines, \
'printdbg/10_shards/100%_reads/fanout_16/2026-04-13-15-19-51/2026-04-13-15-20-09/out/plots/aggregate-combined.csv' title "craq 100%" ls 8 with lines, \
'printdbg/10_shards/0%_reads/fanout_16/2026-04-13-14-33-21/2026-04-13-14-33-39/out/plots/aggregate-combined.csv' title "vr 0%" ls 9 with lines
