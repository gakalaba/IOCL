set datafile separator ','
set key top left
set xlabel 'Throughput (ops/sec)'
set ylabel 'Latency (ms)'
set terminal pngcairo size 800,600 enhanced dashed font 'DejaVu Sans,12'
set output '/users/akalaba/IOCL/experiments/printdbg/2026-04-07-21-42-02/plots/tput-p50-lat.png'
set style line 1 linetype 1 linewidth 2
set style line 2 linetype 1 linecolor "green" linewidth 2
set style line 3 linetype 1 linecolor "blue" linewidth 2
set style line 4 linetype 4 linewidth 2
set style line 5 linetype 5 linewidth 2
set style line 6 linetype 8 linewidth 2
plot '/users/akalaba/IOCL/experiments/printdbg/dummy_spanner/2026-04-03-11-29-49/plots/tput-p50-lat.csv' title 'Dummy Spanner' ls 1 with linespoint, \
'/users/akalaba/IOCL/experiments/printdbg/spanner_dummy__shard_client_w_otpimizations/2026-04-04-14-02-11/plots/tput-p50-lat.csv' title 'Dummy Spanner - client side only' ls 2 with linespoint, \
