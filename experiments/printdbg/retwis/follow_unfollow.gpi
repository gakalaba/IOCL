set datafile separator ','
set title "follow vs. unfollow vs. timeline"
set key bottom right
set xlabel 'Latency (ms)'
set xtics (0, 200, 400, 600, 800)
set ylabel 'Cumulative ratio of operations'
set terminal pngcairo size 800,600 enhanced dashed font 'DejaVu Sans,20'
set output '/users/akalaba/IOCL/experiments/printdbg/retwis/follow_unfollow_timeline.png'
set style line 1 linetype 1 linewidth 2
set style line 2 linetype 1 linecolor "green" linewidth 2
set style line 3 dashtype 4 linecolor "blue" linewidth 2
set style line 4 dashtype 4 linewidth 2
set style line 5 linetype 5 linewidth 2
set style line 6 linetype 8 linewidth 2

plot '/users/akalaba/IOCL/experiments/printdbg/retwis/correct_follow/2026-02-12-08-04-55/2026-02-12-08-05-01/out/plots/aggregate-follow.csv' using 1:2 title "Ellis follow" ls 1 with lines, \
