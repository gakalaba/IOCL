set datafile separator ','
set key bottom right
set ytics (0,0.9,0.99,0.999,0.9999,1.0)
set xlabel 'Latency (ms)'
set ylabel 'Cumulative ratio of operations'
set terminal pngcairo size 800,600 enhanced font 'DejaVu Sans,12'
set output outfile
plot datafile0 using 1:(-log10(1-$2)):yticlabels(3) title 'Protocol' with lines
