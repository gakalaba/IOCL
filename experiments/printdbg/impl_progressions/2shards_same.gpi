set datafile separator ','
set key top left
set xlabel 'Throughput (txn/s)'
set ylabel 'p50 Latency'
set terminal pngcairo size 800,600 enhanced dashed font 'DejaVu Sans,12'
set output '/users/akalaba/IOCL/experiments/printdbg/2shards_same/2shards_same.png'
set style line 1 linetype 1 linewidth 2
set style line 2 linetype 1 linecolor "green" linewidth 2
set style line 3 linetype 1 linecolor "blue" linewidth 2
set style line 4 linetype 4 linewidth 2
set style line 5 linetype 5 linewidth 2
set style line 6 linetype 8 linewidth 2
plot '/users/akalaba/IOCL/experiments/printdbg/2shards_same/micro_iocl_2shards_same_nodes_1/2025-11-18-07-42-24/plots/tput-p50.csv' title '2 shards w leaders on different machines: IOCL\_CT fanout 1' ls 1 with linespoint, \
'/users/akalaba/IOCL/experiments/printdbg/2shards_same/micro_iocl_2shards_same_nodes_2/2025-11-18-08-01-56/plots/tput-p50.csv' title '2 shards w leaders on different machines: IOCL\_CT fanout 2' ls 2 with linespoint, \
