set datafile separator ','
set key top left
set xlabel 'Throughput (txn/s)'
set ylabel 'p50 Latency'
set terminal pngcairo size 800,600 enhanced dashed font 'DejaVu Sans,12'
set output '/users/akalaba/IOCL/experiments/printdbg/n_shards/1BT_v_IOCL.png'
set style line 1 linetype 1 linewidth 2
set style line 2 linetype 1 linecolor "green" linewidth 2
set style line 3 linetype 1 linecolor "blue" linewidth 2
set style line 4 linetype 4 linewidth 2
set style line 5 linetype 5 linewidth 2
set style line 6 linetype 8 linewidth 2

plot '/users/akalaba/IOCL/experiments/printdbg/8shards/8shard_diff/micro_micro_iocl_8shards_diff_nodes_8/2025-11-20-22-12-19/plots/tput-p50.csv' title '1BT Fanout 8 - 8 shards' ls 1 with linespoint, \
'/users/akalaba/IOCL/experiments/printdbg/n_shards/10shards/2025-11-21-15-17-38/plots/tput-p50.csv' title '1BT Fanout 8 - 10 shards' ls 2 with linespoint, \
'/users/akalaba/IOCL/experiments/printdbg/n_shards/12shards/2025-11-21-15-47-22/plots/tput-p50.csv' title '1BT Fanout 8 - 12 shards' ls 3 with linespoint, \
'/users/akalaba/IOCL/experiments/printdbg/n_shards/16shards/2025-11-21-16-17-23/plots/tput-p50.csv' title '1BT Fanout 8 - 16 shards' ls 4 with linespoint, \
'/users/akalaba/IOCL/experiments/printdbg/8shards/8shard_diff/micro_micro_iocl_8shards_diff_nodes_8/2025-11-20-21-53-31/plots/tput-p50.csv' title 'IOCL\_CT Fanout 8 - 8 shards' ls 5 with linespoint, \
'/users/akalaba/IOCL/experiments/printdbg/n_shards/10shards/2025-11-21-14-58-49/plots/tput-p50.csv' title 'IOCL\_CT Fanout 8 - 10 shards' ls 6 with linespoint, \
'/users/akalaba/IOCL/experiments/printdbg/n_shards/12shards/2025-11-21-15-28-28/plots/tput-p50.csv' title 'IOCL\_CT Fanout 8 - 12 shards' ls 7 with linespoint, \
'/users/akalaba/IOCL/experiments/printdbg/n_shards/16shards/2025-11-21-15-58-28/plots/tput-p50.csv' title 'IOCL\_CT Fanout 8 - 16 shards' ls 8 with linespoint